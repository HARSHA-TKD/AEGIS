# Copy to .env and adjust before running the API.
APP_NAME=Aegis API
ENVIRONMENT=development

# PostgreSQL connection string used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

# Change this in any non-local environment. Used for JWT signing and
# repository token encryption (derived with SHA-256).
SECRET_KEY=dev-only-change-me

# Access token lifetime in minutes (default 24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional fallback GitHub token used when a repository is connected
# without an explicit token. Public repositories work without one but are
# subject to the low unauthenticated rate limit.
GITHUB_TOKEN=

# Maximum number of source files fetched per scan.
SCAN_MAX_FILES=200

# Maximum bytes fetched per file.
SCAN_MAX_FILE_BYTES=262144

# Password reset links point at the frontend origin.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30

# Optional SMTP delivery for password reset emails. When unset, reset links
# are logged locally instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
